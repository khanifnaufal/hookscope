# Server port
PORT=3000

# Database - use local file for dev, Turso URL for production
DATABASE_URL=file:./data/local.db

# Turso auth token - required only for production (Turso cloud)
# TURSO_AUTH_TOKEN=

# Public base URL - used to build hook URLs shown to users
PUBLIC_BASE_URL=http://localhost:3000

# Auto-delete endpoints after N days (default: 7)
ENDPOINT_TTL_DAYS=7

# Comma-separated list of allowed CORS origins for /api/* routes.
# Leave unset in dev to allow all origins. Set in production to your frontend URL.
# ALLOWED_ORIGINS=https://your-app.onrender.com
